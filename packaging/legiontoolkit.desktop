[Desktop Entry]
Version=1.0
Type=Application
Name=Legion Toolkit
GenericName=Laptop Control Panel
Comment=Control power modes, thermals, lighting and battery on Lenovo Legion laptops
Icon=legiontoolkit
Exec=legiontoolkit
Terminal=false
Categories=Settings;HardwareSettings;Utility;
Keywords=Legion;Lenovo;laptop;fan;thermal;battery;rgb;power;
StartupNotify=true

# Runs unprivileged. Individual writes escalate to the installed
# legiontoolkit-helper via pkexec, so the process itself never needs root.
