// Let a user at the physical console use Legion Toolkit without a password.
//
// Why this exists: every writable hardware file is mode 0644 root-only, so
// changing the power mode needs root, and pkexec therefore asks. The prompt is
// not a bug — it is the kernel's permissions showing through.
//
// What it grants: the `org.legiontoolkit.helper` action, and nothing else. The
// helper validates the capability key against a fixed allowlist and the
// resolved destination against a fixed set of sysfs roots, so this cannot be
// used to write anywhere else.
//
// Only `active` and `local` sessions are allowed — someone at the machine with
// a logged-in desktop. A remote or inactive session still authenticates.
//
// Install to /etc/polkit-1/rules.d/49-legiontoolkit.rules to enable, or remove
// the file to go back to a password prompt. Installed only when the build is
// asked for it: `sudo make install LEGIONTOOLKIT_NO_PASSWORD=1`.

polkit.addRule(function (action, subject) {
    if (action.id == "org.legiontoolkit.helper" && subject.local && subject.active) {
        return polkit.Result.YES;
    }
});
