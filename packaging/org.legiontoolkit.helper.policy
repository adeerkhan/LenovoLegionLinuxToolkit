<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!--
  Polkit action for the privileged helper.

  THIS IS A TEMPLATE. `install.sh` substitutes the placeholders below and writes
  the rendered file to $POLKITDIR. It is not installed verbatim.

  The `org.freedesktop.policykit.exec.path` annotation must name the exact
  absolute path of the helper binary. polkit matches it literally: if the two
  ever diverge, pkexec refuses the request and every write in the application
  reports as refused, which is indistinguishable from the feature being broken.
  Keeping the path here as a placeholder is what makes that impossible to get
  wrong by hand — the Makefile computes it once and install.sh uses the same
  value.

  `auth_admin` (not `auth_admin_keep`) is deliberate: writing to the embedded
  controller is not something to silently remember. Someone changing a fan
  curve can re-authenticate; someone flipping a toggle from an automation
  profile must not end up with a permanently authorised session.
-->
<policyconfig>

  <vendor>Legion Linux Toolkit</vendor>
  <vendor_url>https://github.com/adeerkhan/legion-toolkit</vendor_url>

  <action id="@POLKIT_ACTION@">
    <description>Write hardware settings on a Lenovo Legion laptop</description>
    <description xml:lang="en">Write hardware settings on a Lenovo Legion laptop</description>
    <message>
      Authentication is required to change hardware settings on your Lenovo Legion laptop.
    </message>
    <message xml:lang="en">
      Authentication is required to change hardware settings on your Lenovo Legion laptop.
    </message>

    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>

    <annotate key="org.freedesktop.policykit.exec.path">@HELPER_PATH@</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>

</policyconfig>
